# Copy to .env or export equivalent variables before running local/remote jobs.

# Repository-local data/cache root used by VLMEvalKit.
LMUData=./LMUData

# Model and Python environment roots used by scripts/configs/models.yaml.
MODEL_ROOT=/models
CONDA_ROOT=${HOME}/miniconda3

# Optional auxiliary roots for legacy/probe models.
LLAVA_ROOT=/path/to/LLaVA
QWEN35_PYDEPS=

# Judge endpoint for LLM-scored benchmarks. Leave keys empty in the repo.
OPENAI_API_KEY_JUDGE=
OPENAI_API_BASE_JUDGE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_API_BASE=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# Optional non-default JT API wrappers. They are unset by default.
JT_VL_CHAT_API_BASE=
JT_VL_CHAT_MINI_API_BASE=
JT_VL_CHAT_2B_API_BASE=
JT_VL_CHAT_APP_CODE=

# Common runtime toggles.
HF_ENDPOINT=https://hf-mirror.com
CONTROL_PYTHON=python
PYTHONNOUSERSITE=1
